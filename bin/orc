#!/usr/bin/env bash
# Zero-install launcher for people who cloned this repo instead of `pip
# install`-ing it. If you pip-installed (or `pipx install`), you already have
# a real `orc` console script on PATH and don't need this file at all.
#
# Add this repo's bin/ to your PATH once (e.g. in ~/.zshrc):
#   export PATH="$HOME/path/to/claude-orchestrator/bin:$PATH"
set -e
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Deliberately does NOT cd into src/ — `orc memory here` resolves memories
# against the user's current directory, so the launcher must preserve cwd.
# PYTHONPATH gets the interpreter to the package without moving us.
exec env PYTHONPATH="$SCRIPT_DIR/../src${PYTHONPATH:+:$PYTHONPATH}" python3 -m orc "$@"
